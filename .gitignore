# Android — отдельный репозиторий
running-tracker-android/

# Python
__pycache__/
*.pyc
*.pyo
.env
venv/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Test fixtures — local activity files (personal GPS data, not committed)
tests/fixtures/*.fit
# …except the synthetic, GPS-free fixture used by CI (committed on purpose)
!tests/fixtures/synthetic_activity.fit

# pytest
.pytest_cache/

# Секреты — в репозиторий не попадают никогда.
# Auth/ — выгрузки OAuth-клиента из Google Cloud Console; шаблон ниже ловит
# такой файл и вне этой папки, если он окажется где-то ещё.
Auth/
*client_secret*.json
